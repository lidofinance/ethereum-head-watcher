# Everything the runtime image has no use for. build-info.json and assets/ are deliberately absent:
# the first comes from the checkout or build args, and the ABIs in the second are read at startup.
.git
.github
.gitignore
.dockerignore
.hadolint.yaml
Dockerfile
renovate.json

.env
.env.*

__pycache__
*.pyc
*.pyo
.venv
venv
.pytest_cache
.mypy_cache
*.log

tests
docker-compose.yml
docker/alertmanager
docker/alertmanager-discord
docker/prometheus
CHANGELOG.md
README.md
